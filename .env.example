# Mule Sentinel - Intelligence & Investigation Platform Configuration

# Environment ('development' | 'production' | 'test')
ENVIRONMENT=development

# Database Connection (defaults to local SQLite if left empty)
# SQLite: sqlite:///data/mule_platform.db
# PostgreSQL: postgresql://mule_admin:mule_secure_pass@localhost:5432/mule_platform
DATABASE_URL=sqlite:///data/mule_platform.db

# Machine Learning Artifacts
ML_MODEL_PATH=ml/models/mule_detector_pipeline.joblib

# Security & CORS
SECRET_KEY=change-in-production-super-secret-mule-key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Web Frontend Port
WEB_PORT=3000
